---
style: /css/art.css
layout: base.njk
permalink: "/art/"
---
<div class="post-content">
  <div class="box" style="margin:unset;">
    <div class="box-title">
      <span>ART</span>
    </div>
    <div class="box-content">
      <h1>{{ title }}</h1>
      <p>
        <strong>Posted: </strong> {{ date | niceDate }}<br />
        <strong>Categories:</strong>
        {% for cats in artCategories %}
          <a href="/art-categories/{{ cats | slugify }}/">{{ cats }}</a>
        {% endfor %}
      </p>
      <article>{{ content | safe }}</article>
    </div>
  </div>
    <div id="c_widget" style="margin-top"></div>
    <script src="/js/comment-widget.js"></script>
    </div>
</div>