---json
{
  "permalink": "updates.xml",
  "eleventyExcludeFromCollections": true,
  "metadata": {
    "title": "My Blog",
    "subtitle": "I am writing about stuff.",
    "url": "https://example.com/",
    "feedUrl": "https://example.com/feed.xml",
    "author": {
      "name": "Your Name",
      "email": "me@example.com"
    }
  }
}
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ metadata.title }}</title>
  <subtitle>{{ metadata.subtitle }}</subtitle>
  <link href="{{ metadata.feedUrl }}" rel="self"/>
  <link href="{{ metadata.url }}"/>
  <updated>{{ collections.updates | getNewestCollectionItemDate | dateToRfc3339 }}</updated>
  <id>{{ metadata.url }}</id>
  <author>
    <name>{{ metadata.author.name }}</name>
    <email>{{ metadata.author.email }}</email>
  </author>
  {%- for updates in collections.updates | reverse %}
  {% set absolutePostUrl %}{{ updates.url | url | absoluteUrl(metadata.url) }}{% endset %}
  <entry>
    <title>{{ updates.data.title }}</title>
    <link href="{{ absolutePostUrl }}"/>
    <updated>{{ updates.date | dateToRfc3339 }}</updated>
    <id>{{ absolutePostUrl }}</id>
    <content type="html">{{ updates.templateContent | htmlToAbsoluteUrls(absolutePostUrl) }}</content>
  </entry>
  {%- endfor %}
</feed>